# ---- 构建中间目录 / CMake & build trees ----
# build-*/ 覆盖 build-android / build-windows / build-linux / build-macos
build/
build-*/
cmake-build-*/

# ---- 最终分发包目录 / release artifacts (track skeleton only) ----
# 按平台分类于 artifacts/<platform>/；仅保留 README.md 与各子目录 .gitkeep，
# 其余包、暂存目录、二进制与校验和全部忽略。
/artifacts/*
!/artifacts/README.md
!/artifacts/*/
/artifacts/*/*
!/artifacts/*/.gitkeep

# 历史产物目录（兼容旧脚本输出）/ legacy dist output
dist/

# ---- 二进制与归档产物 / binaries & archives ----
*.o
*.obj
*.exe
*.out
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.apk
*.aab
*.deb
*.rpm
*.dmg
*.pkg
*.pkg.tar.zst
*.zip
*.7z
*.tar.gz
*.tar.xz
*.AppImage
*.pdb
*.ilk
*.exp
*.sha256

# ---- Qt / CMake 自动生成 / generated by Qt & CMake ----
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.user
*.user.*
.qmake.stash

# ---- 含口令的本地配置 / local config with credentials ----
config.json
*.local.ini

# ---- Android 签名密钥库 / signing keystore（私钥，绝不入库）----
# Android signing keystore / private key must never be committed.
*.jks
*.keystore
*.p12
*.pfx
*.keystore.b64
*.jks.b64

# ---- 日志 / logs ----
*.log

# ---- 编辑器与系统垃圾 / editor & OS junk ----
.trae/
.vscode/
.idea/
Thumbs.db
.DS_Store
